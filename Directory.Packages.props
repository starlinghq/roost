<Project>
  <!--
    Versions are central and locked (packages.lock.json; CI restores in locked mode). Pin native and runtime
    packages exactly ([x]) with a comment saying why. Engine packages (Abstractions, Ops, Engine, Worker, Kernels,
    Cuda, Models.*, Generation.Roost) must never reach Microsoft.ML.OnnxRuntime*, directly or transitively:
    tools/check-roost-boundaries.py enforces it in CI.
  -->
  <ItemGroup>
    <!-- Starling's published packages, exact pins (plan 2.2). They bring ONNX Runtime GenAI: host-process packages only (decision 30). -->
    <PackageVersion Include="Starlings.Generation.OnnxGenAI" Version="[0.2.0]" />
    <PackageVersion Include="Starlings.Models.Qwen35" Version="[0.2.0]" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
