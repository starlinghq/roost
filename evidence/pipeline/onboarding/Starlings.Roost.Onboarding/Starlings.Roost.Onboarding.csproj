<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The roost-v1 onboarding plugin (R-055, stream I): `inspect` maps a Hugging Face config.json to the C3 op vocabulary and C4 state groups and reports whether the model composes from existing ops; `validate-recipe` checks recipes in evidence/recipes/ against the strict roost-v1 recipe schema. A tool, never shipped in the runtime.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>roost-onboard</AssemblyName>
    <RootNamespace>Starlings.Roost.Onboarding</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- C3 (OpId, OpCatalog), C4 (StateGroupDescriptor) and CpuOps.Supports, the reference implementation status of each op. -->
    <ProjectReference Include="../../../../src/Starlings.Roost.Abstractions/Starlings.Roost.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Starlings.Roost.Ops/Starlings.Roost.Ops.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas/roost-recipe-v1.schema.json" LogicalName="roost-recipe-v1.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Roost.Onboarding.Tests" />
  </ItemGroup>
</Project>
