<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Roost kernel library loader (stream F, R-023): loads a kernel library by its C1 exports, applies the ABI major and minor rule, checks the manifest and library digests, and reports a missing specialisation or SM as a typed ProfileUnsupported failure. Worker-side: never loads ONNX Runtime.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Starlings.Acquisition" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Starlings.Roost.Abstractions/Starlings.Roost.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The manifest this build was made from (contract C5): its digests are the release assets' digests for this package version (R-060). -->
    <EmbeddedResource Include="../../kernels/manifest.toml" LogicalName="Starlings.Roost.Kernels.manifest.toml" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Roost.Kernels.Tests" />
    <InternalsVisibleTo Include="Starlings.Roost.Kernels.Tests.Cuda" />
  </ItemGroup>
</Project>
