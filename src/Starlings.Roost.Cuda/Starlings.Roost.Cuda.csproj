<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local only, not in Roost.slnx (AGENTS.md): CUDA projects stay out of the solution. -->
  <PropertyGroup>
    <Description>Roost CUDA bindings (stream F, R-023): the CUDA runtime, driver, cuBLASLt and NVML subset the worker calls, generated by tools/generate-cuda-bindings.py from the pinned CUDA 13.3 headers, and the per-OS library resolver. Worker-side: never loads ONNX Runtime.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Roost.Kernels.Tests" />
    <InternalsVisibleTo Include="Starlings.Roost.Kernels.Tests.Cuda" />
  </ItemGroup>
</Project>
