<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Roost engine core (stream G). R-027: request queue, plan and result rings over the C8 shared-memory segment, polling threads. R-028: typed block manager. R-029: planner with chunked prefill, recompute preemption and priority and deadline scheduling. R-030: prefix cache with a hash chain per group, recurrent snapshots at attention block boundaries and LRU eviction.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Starlings.Roost.Abstractions/Starlings.Roost.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Starlings.Roost.Engine.Tests" />
  </ItemGroup>
</Project>
