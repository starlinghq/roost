<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local only, not in Roost.slnx (AGENTS.md): streams the locked Qwen3.5-0.8B checkpoint to a GPU (R-024) and runs the eager worker's greedy decode against CpuOps (R-025). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Roost.Abstractions/Starlings.Roost.Abstractions.csproj" />
    <ProjectReference Include="../../src/Starlings.Roost.Cuda/Starlings.Roost.Cuda.csproj" />
    <ProjectReference Include="../../src/Starlings.Roost.Worker/Starlings.Roost.Worker.csproj" />
    <ProjectReference Include="../../src/Starlings.Roost.Ops/Starlings.Roost.Ops.csproj" />
    <ProjectReference Include="../../src/Starlings.Roost.Kernels/Starlings.Roost.Kernels.csproj" />
    <ProjectReference Include="../../src/Starlings.Roost.Models.Qwen35/Starlings.Roost.Models.Qwen35.csproj" />
    <ProjectReference Include="../../src/Starlings.Roost.Worker.Qwen35/Starlings.Roost.Worker.Qwen35.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiled in CI by Starlings.Roost.Worker.Tests; shared here so the GPU run uses the same plan writer, adapter and probe. -->
    <Compile Include="../Starlings.Roost.Worker.Tests/Support/PlanWriter.cs" Link="Support/PlanWriter.cs" />
    <Compile Include="../Starlings.Roost.Worker.Tests/Support/Probe.cs" Link="Support/Probe.cs" />
    <Compile Include="../Starlings.Roost.Worker.Tests/Support/ProbedQwen35EagerModel.cs" Link="Support/ProbedQwen35EagerModel.cs" />
  </ItemGroup>
</Project>
