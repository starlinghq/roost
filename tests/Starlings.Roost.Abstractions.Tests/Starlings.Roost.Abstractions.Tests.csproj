<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Starlings.Roost.Abstractions/Starlings.Roost.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The C contract headers and their gcc layout, read as text by the layout and constant tests (no C compiler). -->
    <None Include="Layout/abi-layout.golden.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../kernels/include/*.h" Link="Layout/include/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
