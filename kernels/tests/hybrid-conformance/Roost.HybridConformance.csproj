<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local only, not in Roost.slnx (AGENTS.md): R-034 conformance of the hybrid GPU ops (CausalConv1d, the recurrent state
       ops, GatedDeltaRule) against CpuOps (R-018) on random inputs. Loads a built libroost_kernels_sm<N>.so through its C1
       exports and calls it with the CUDA runtime. Run through tools/gpu-lease (kernels/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Roost.HybridConformance</AssemblyName>
    <RootNamespace>Roost.HybridConformance</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- A command-line harness: culture, localisation and disposal-analysis rules add noise, not safety. -->
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1307;CA1308;CA1062;CA2000;CA1515;CA1812;CA1861;CA1814;CA1707;CA5394;CA1031;CA2201;CA1859</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Starlings.Roost.Abstractions/Starlings.Roost.Abstractions.csproj" />
    <ProjectReference Include="../../../src/Starlings.Roost.Ops/Starlings.Roost.Ops.csproj" />
  </ItemGroup>
</Project>
